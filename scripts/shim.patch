+    // poly-editor overlay: the notes held on this slot (OpenTracker's SynthBank registry, one note per key here): ISynthEngine
+    // engines read them as SynthParams::held (A-Type's Keyboard Duo), and with kSynthFlagNotePriority at polyphony 1 they
+    // decide which note sounds (priorityParam: 0 Last, 1 Low, 2 High): a losing note is held silently, the release of the
+    // sounding note returns the voice to the winner of the notes still held.
+    void heldAdd(uint8_t note, uint8_t velocity)
+    {
+        heldRemove(note);
+        if (nHeld < kMaxHeld)
+        {
+            heldNote[nHeld] = note;
+            heldVel[nHeld] = velocity;
+            nHeld++;
+        }
+    }
+    void heldRemove(uint8_t note)
+    {
+        for (int i = 0; i < nHeld; i++)
+        {
+            if (heldNote[i] == note)
+            {
+                for (int j = i + 1; j < nHeld; j++)
+                {
+                    heldNote[j - 1] = heldNote[j];
+                    heldVel[j - 1] = heldVel[j];
+                }
+                nHeld--;
+                return;
+            }
+        }
+    }
+    void heldPublish()
+    {
+        if (!gHeldNotes) // Strict (match my Tracker): the firmware never fills SynthParams::held
+        {
+            params.held = ot::audio::SynthHeld{};
+            return;
+        }
+        ot::audio::SynthHeld h;
+        h.count = uint8_t(nHeld);
+        h.mono = voiceCount == 1;
+        h.low = 255;
+        h.high = 0;
+        for (int i = 0; i < nHeld; i++)
+        {
+            h.low = std::min(h.low, heldNote[i]);
+            h.high = std::max(h.high, heldNote[i]);
+        }
+        if (!nHeld)
+        {
+            h.low = 0;
+        }
+        params.held = h;
+    }
+    bool priorityMode() const { return gHeldNotes && voiceCount == 1 && def && (def->flags & open::kFlagNotePriority); }
+    int heldWinner() const // index into heldNote of the note that should sound, -1 none
+    {
+        const int mode = def->priorityParam >= 0 ? int(params.end[def->priorityParam] + 0.5f) : 0;
+        int w = -1;
+        for (int i = 0; i < nHeld; i++)
+        {
+            if (w < 0)
+            {
+                w = i;
+                continue;
+            }
+            const int d = mode == 1 ? int(heldNote[w]) - int(heldNote[i]) : (mode == 2 ? int(heldNote[i]) - int(heldNote[w]) : 0);
+            if (d >= 0) // later keys win ties (Last)
+            {
+                w = i;
+            }
+        }
+        return w;
     }
 
